# Database Configuration
POSTGRES_DB=edo_db
POSTGRES_USER=edo_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Security & JWT Configuration
# Minimum 256-bit cryptographically secure secret key
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_256_bits_long_abcdef123456
JWT_EXPIRATION_MS=86400000

# Application URLs & CORS
FRONTEND_PUBLIC_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# SMTP Mail Integration (For Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@edo.app
